{
  "title": "Core Awakening",
  "css": "body{margin:0;padding:0;background:#0b0e1a;overflow:hidden}canvas{display:block;user-select:none}",
  "html": "",
  "js": "new GF.Game({id:\"core-awakening\",title:\"Core Awakening\",width:960,height:540,palette:[\"#00FFFF\",\"#D0D0D0\",\"#FFA500\",\"#FF4500\"],background:\"#0b0e1a\"}).add(\"play\",{init(){this.player={x:480,y:270,width:30,height:30,health:3};this.enemies=[];this.score=0;this.spawnEnemy();this.particles=new GF.Particles();this.input=game.input;this.lastHitTime=0;},update(dt){if(this.input.keys[\"ArrowLeft\"]){this.player.x-=200*dt;}if(this.input.keys[\"ArrowRight\"]){this.player.x+=200*dt;}if(this.input.keys[\"ArrowUp\"]){this.player.y-=200*dt;}if(this.input.keys[\"ArrowDown\"]){this.player.y+=200*dt;}this.player.x=GF.math.clamp(this.player.x,0,960-this.player.width);this.player.y=GF.math.clamp(this.player.y,0,540-this.player.height);this.enemies.forEach((e)=>{e.y+=e.speed*dt;if(e.y>540){this.addScore(1);this.removeEnemy(e);}if(GF.math.dist(this.player.x,this.player.y,e.x,e.y)<(this.player.width+e.width)/2){this.player.health-=1;this.hitStop(0.1);this.shake(6,0.3);this.removeEnemy(e);if(this.player.health<=0){game.gameOver({message:\"GAME OVER\"});}}});if(this.input.pointer.clicked){this.enemies.forEach((e)=>{if(GF.math.dist(this.input.pointer.x,this.input.pointer.y,e.x,e.y)<(this.player.width+e.width)/2){this.addScore(2);this.burst(e.x,e.y,{count:10,speed:100,size:4,colors:[\"#FFA500\"]});this.removeEnemy(e);}});this.input.pointer.clicked=false;}if(this.enemies.length<5){this.spawnEnemy();},draw(ctx){ctx.fillStyle=\"#00FFFF\";ctx.fillRect(this.player.x,this.player.y,this.player.width,this.player.height);this.enemies.forEach((e)=>{ctx.fillStyle=\"#FF4500\";ctx.fillRect(e.x,e.y,e.width,e.height);});this.particles.update(1/60);this.particles.draw(ctx);GF.Draw.text(ctx,String(this.score),480,40,{size:34,color:\"#fff\"});},spawnEnemy(){const enemy={x:Math.random()*930,y:-30,width:40,height:40,speed:Math.random()*100+50};this.enemies.push(enemy);},removeEnemy(e){const index=this.enemies.indexOf(e);if(index>-1)this.enemies.splice(index,1);}});game.titleScreen({subtitle:\"Rebuild your identity!\",onStart:()=>game.go(\"play\")});"
}
